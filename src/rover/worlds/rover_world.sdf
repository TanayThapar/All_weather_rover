<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="mega_rover_proving_ground_v4">

    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <!-- rmagine Embree (CPU) Map Plugin - Required for radarays radar simulation -->
    <!-- Builds a BVH acceleration structure for ray tracing over the Gazebo world -->
    <plugin name='rmagine_embree_map' filename='librmagine_embree_map_gzplugin.so'>
      <update>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
        <delta_scale>0.001</delta_scale>
        <rate_limit>200</rate_limit>
      </update>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 150 0.6 0.2 0</pose>
      <diffuse>0.85 0.8 0.7 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <model name="base_ground">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material><ambient>0.45 0.38 0.28 1</ambient><diffuse>0.45 0.38 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =================================================== -->
    <!-- ZONE 0: HIGH SPEED SLALOM RUNWAY (Y = -150) -->
    <!-- =================================================== -->
    <model name="speed_slalom_runway">
      <static>true</static>
      <pose>0 -150 0 0 0 0</pose>
      <link name="runway_strip">
        <pose>0 0 0.005 0 0 0</pose>
        <visual name="vis">
          <geometry><box><size>24 260 0.01</size></box></geometry>
          <material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material>
        </visual>
      </link>
      <link name="p1"><pose>-4 -100 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
      <link name="p2"><pose>4 -70 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
      <link name="p3"><pose>-4 -40 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
      <link name="p4"><pose>4 -10 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
      <link name="p5"><pose>-4 20 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
      <link name="p6"><pose>4 50 1 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2</length></cylinder></geometry><material><ambient>0.9 0.4 0 1</ambient><diffuse>0.9 0.4 0 1</diffuse></material></visual></link>
    </model>

    <!-- =================================================== -->
    <!-- ZONE 1: DENSE FOREST WITH CENTER PATH (X=180, Y=0) -->
    <!-- =================================================== -->
    <model name="forest_center_path_zone">
      <static>true</static>
      <pose>180 0 0 0 0 0</pose>

      <!-- Center Dirt Runway (5m Wide Clear Path) -->
      <link name="center_path_surface">
        <pose>0 0 0.008 0 0 0</pose>
        <visual name="v">
          <geometry><box><size>5 120 0.01</size></box></geometry>
          <material><ambient>0.28 0.18 0.1 1</ambient><diffuse>0.28 0.18 0.1 1</diffuse></material>
        </visual>
      </link>

      <!-- West Tree Line (Left of Path) -->
      <link name="tw1"><pose>-4 -55 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.8</radius></sphere></geometry><material><ambient>0.04 0.28 0.04 1</ambient><diffuse>0.04 0.28 0.04 1</diffuse></material></visual></link>
      <link name="tw2"><pose>-10 -45 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.0</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="tw3"><pose>-5 -35 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.5</radius></sphere></geometry><material><ambient>0.03 0.25 0.03 1</ambient><diffuse>0.03 0.25 0.03 1</diffuse></material></visual></link>
      <link name="tw4"><pose>-14 -25 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.48</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.48</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.2</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="tw5"><pose>-4 -15 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.6</radius></sphere></geometry><material><ambient>0.04 0.26 0.04 1</ambient><diffuse>0.04 0.26 0.04 1</diffuse></material></visual></link>
      <link name="tw6"><pose>-12 -5 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.52</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.52</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.4</radius></sphere></geometry><material><ambient>0.06 0.32 0.06 1</ambient><diffuse>0.06 0.32 0.06 1</diffuse></material></visual></link>
      <link name="tw7"><pose>-4 5 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.38</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.38</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.3</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="tw8"><pose>-15 15 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.45</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.9</radius></sphere></geometry><material><ambient>0.04 0.27 0.04 1</ambient><diffuse>0.04 0.27 0.04 1</diffuse></material></visual></link>
      <link name="tw9"><pose>-5 25 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.5</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="tw10"><pose>-11 35 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.1</radius></sphere></geometry><material><ambient>0.03 0.25 0.03 1</ambient><diffuse>0.03 0.25 0.03 1</diffuse></material></visual></link>
      <link name="tw11"><pose>-4 45 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.7</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="tw12"><pose>-16 55 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.46</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.46</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.0</radius></sphere></geometry><material><ambient>0.04 0.28 0.04 1</ambient><diffuse>0.04 0.28 0.04 1</diffuse></material></visual></link>

      <!-- East Tree Line (Right of Path) -->
      <link name="te1"><pose>4 -55 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.4</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="te2"><pose>12 -45 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.48</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.48</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.1</radius></sphere></geometry><material><ambient>0.04 0.28 0.04 1</ambient><diffuse>0.04 0.28 0.04 1</diffuse></material></visual></link>
      <link name="te3"><pose>4 -35 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.7</radius></sphere></geometry><material><ambient>0.05 0.32 0.05 1</ambient><diffuse>0.05 0.32 0.05 1</diffuse></material></visual></link>
      <link name="te4"><pose>15 -25 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.3</radius></sphere></geometry><material><ambient>0.06 0.3 0.06 1</ambient><diffuse>0.06 0.3 0.06 1</diffuse></material></visual></link>
      <link name="te5"><pose>4 -15 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.38</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.38</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.3</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="te6"><pose>10 -5 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.52</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.52</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.2</radius></sphere></geometry><material><ambient>0.04 0.27 0.04 1</ambient><diffuse>0.04 0.27 0.04 1</diffuse></material></visual></link>
      <link name="te7"><pose>4 5 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.44</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.44</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.8</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="te8"><pose>14 15 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.4</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.5</radius></sphere></geometry><material><ambient>0.03 0.26 0.03 1</ambient><diffuse>0.03 0.26 0.03 1</diffuse></material></visual></link>
      <link name="te9"><pose>4 25 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.46</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.46</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.9</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
      <link name="te10"><pose>11 35 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.5</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>4.0</radius></sphere></geometry><material><ambient>0.04 0.28 0.04 1</ambient><diffuse>0.04 0.28 0.04 1</diffuse></material></visual></link>
      <link name="te11"><pose>4 45 3 0 0 0</pose><collision name="c"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.42</radius><length>6</length></cylinder></geometry><material><ambient>0.2 0.1 0.05 1</ambient><diffuse>0.2 0.1 0.05 1</diffuse></material></visual><visual name="canopy"><pose>0 0 4 0 0 0</pose><geometry><sphere><radius>3.6</radius></sphere></geometry><material><ambient>0.05 0.3 0.05 1</ambient><diffuse>0.05 0.3 0.05 1</diffuse></material></visual></link>
