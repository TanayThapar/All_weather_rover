    <!-- =================================================== -->
    <!-- ZONE 2: GRAND CANYON CHICANE PASS (NORTH: X=0, Y=220) -->
    <!-- =================================================== -->
    <model name="canyon_chicane_complex">
      <static>true</static>
      <pose>0 220 0 0 0 0</pose>
      <link name="cliff_west"><pose>-25 0 12 0 0 0</pose><collision name="col"><geometry><box><size>30 180 24</size></box></geometry></collision><visual name="vis"><geometry><box><size>30 180 24</size></box></geometry><material><ambient>0.5 0.25 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual></link>
      <link name="cliff_east"><pose>25 0 12 0 0 0</pose><collision name="col"><geometry><box><size>30 180 24</size></box></geometry></collision><visual name="vis"><geometry><box><size>30 180 24</size></box></geometry><material><ambient>0.5 0.25 0.1 1</ambient><diffuse>0.5 0.25 0.1 1</diffuse></material></visual></link>
      <link name="baffle_1"><pose>-4 -40 4 0 0 0</pose><collision name="c"><geometry><box><size>14 4 8</size></box></geometry></collision><visual name="v"><geometry><box><size>14 4 8</size></box></geometry><material><ambient>0.45 0.22 0.08 1</ambient><diffuse>0.45 0.22 0.08 1</diffuse></material></visual></link>
      <link name="baffle_2"><pose>4 0 4 0 0 0</pose><collision name="c"><geometry><box><size>14 4 8</size></box></geometry></collision><visual name="v"><geometry><box><size>14 4 8</size></box></geometry><material><ambient>0.45 0.22 0.08 1</ambient><diffuse>0.45 0.22 0.08 1</diffuse></material></visual></link>
      <link name="baffle_3"><pose>-4 40 4 0 0 0</pose><collision name="c"><geometry><box><size>14 4 8</size></box></geometry></collision><visual name="v"><geometry><box><size>14 4 8</size></box></geometry><material><ambient>0.45 0.22 0.08 1</ambient><diffuse>0.45 0.22 0.08 1</diffuse></material></visual></link>
    </model>

    <!-- =================================================== -->
    <!-- ZONE 3: MUD BASIN & RAIN SYSTEM (SOUTHWEST: X=-180, Y=-180) -->
    <!-- =================================================== -->
    <model name="mud_basin_rain">
      <static>true</static>
      <pose>-180 -180 0 0 0 0</pose>
      <link name="mud_patch_main">
        <pose>0 0 0.01 0 0 0</pose>
        <collision name="col">
          <geometry><box><size>120 120 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.08</mu><mu2>0.08</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>120 120 0.02</size></box></geometry>
          <material>
            <ambient>0.08 0.12 0.16 1</ambient>
            <diffuse>0.08 0.12 0.16 1</diffuse>
            <specular>0.98 0.98 0.98 1</specular>
          </material>
        </visual>
      </link>
      <link name="rain_emitter_link">
        <pose>0 0 18 0 0 0</pose>
        <particle_emitter name="rain_particles" type="box">
          <pose>0 0 0 0 0 0</pose>
          <size>110 110 1</size>
          <rate>400</rate>
          <lifetime>1.5</lifetime>
          <speed>14.0</speed>
          <particle_size>0.04 0.04 0.7</particle_size>
          <color_start>0.7 0.8 1.0 0.7</color_start>
          <color_end>0.5 0.7 0.9 0.2</color_end>
          <material>
            <ambient>0.7 0.8 1.0 0.6</ambient>
            <diffuse>0.7 0.8 1.0 0.6</diffuse>
          </material>
        </particle_emitter>
      </link>
    </model>

    <!-- =================================================== -->
    <!-- ZONE 4: HIGH-DENSITY BOULDER LABYRINTH (NW: X=-180, Y=180) -->
    <!-- =================================================== -->
    <model name="boulder_labyrinth_dense">
