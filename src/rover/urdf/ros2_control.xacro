<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rover_ros2_control">

    <!-- ============================================================ -->
    <!-- Native Gazebo Harmonic Ackermann Steering plugin              -->
    <!-- Subscribes to /model/all_weather_explorer/cmd_vel (gz topic) -->
    <!-- ros_gz_bridge maps /cmd_vel (ROS) -> that gz topic            -->
    <!-- ============================================================ -->
    <gazebo>
      <plugin
        filename="gz-sim-ackermann-steering-system"
        name="gz::sim::systems::AckermannSteering">

        <!-- Command topic (Gazebo Transport) -->
        <topic>/model/all_weather_explorer/cmd_vel</topic>

        <!-- Rear drive wheels -->
        <left_rear_wheel_joint>rear_left_wheel_joint</left_rear_wheel_joint>
        <right_rear_wheel_joint>rear_right_wheel_joint</right_rear_wheel_joint>

        <!-- Front steering knuckles -->
        <left_front_wheel_steering_joint>front_left_steering_joint</left_front_wheel_steering_joint>
        <right_front_wheel_steering_joint>front_right_steering_joint</right_front_wheel_steering_joint>

        <!-- Front passive rolling wheels -->
        <left_front_wheel_joint>front_left_wheel_joint</left_front_wheel_joint>
        <right_front_wheel_joint>front_right_wheel_joint</right_front_wheel_joint>

        <!-- Match wheels.xacro values -->
        <wheel_separation>0.56</wheel_separation>
        <wheel_base>0.60</wheel_base>
        <wheel_radius>0.12</wheel_radius>

        <!-- Steering limits (radians) -->
        <steering_limit>0.5</steering_limit>

        <!-- Max speed (m/s) -->
        <min_velocity>-2.0</min_velocity>
        <max_velocity>2.0</max_velocity>
        <min_acceleration>-3</min_acceleration>
        <max_acceleration>3</max_acceleration>

      </plugin>
    </gazebo>

    <!-- ============================================================ -->
    <!-- Odometry publisher                                            -->
    <!-- ============================================================ -->
    <gazebo>
      <plugin
        filename="gz-sim-odometry-publisher-system"
        name="gz::sim::systems::OdometryPublisher">
        <robot_base_frame>base_link</robot_base_frame>
        <odom_frame>odom</odom_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <!-- ============================================================ -->
    <!-- Joint state publisher (so ROS joint_states topic is fed)     -->
    <!-- ============================================================ -->
    <gazebo>
      <plugin
        filename="gz-sim-joint-state-publisher-system"
        name="gz::sim::systems::JointStatePublisher">
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>front_left_steering_joint</joint_name>
        <joint_name>front_right_steering_joint</joint_name>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
