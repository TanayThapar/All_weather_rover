<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="rover_base">

    <link name="base_link">

      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.8 0.5 0.3"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.8 0.5 0.3"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="25.0"/>

        <inertia
          ixx="0.90"
          ixy="0.0"
          ixz="0.0"
          iyy="1.90"
          iyz="0.0"
          izz="2.40"/>
      </inertial>

    </link>

    <gazebo reference="base_link">
      <material>Gazebo/DarkGrey</material>

      <self_collide>false</self_collide>
      <gravity>true</gravity>

      <mu1>1.5</mu1>
      <mu2>1.5</mu2>

      <kp>1000000</kp>
      <kd>100</kd>
    </gazebo>

  </xacro:macro>

</robot>