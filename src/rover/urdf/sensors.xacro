<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="rover_sensors">

    <!-- IMU -->
    <link name="imu_link">
      <visual>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.04 0.04 0.02"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="1e-5"
          iyy="1e-5"
          izz="1e-5"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <joint name="imu_joint" type="fixed">
      <parent link="base_link"/>
      <child link="imu_link"/>
      <origin xyz="0 0 0"/>
    </joint>

    <!-- LiDAR -->
    <link name="lidar_top_link">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.08"/>
        </geometry>
        <material name="black"/>
      </visual>

      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.08"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="0.0005"
          iyy="0.0005"
          izz="0.0005"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_top_link"/>
      <origin xyz="0 0 0.60"/>
    </joint>

    <!-- GPS -->
    <link name="gps_link"/>

    <joint name="gps_joint" type="fixed">
      <parent link="base_link"/>
      <child link="gps_link"/>
      <origin xyz="-0.30 0 0.80"/>
    </joint>

    <!-- Radar -->
    <link name="radar_front_link">
      <visual>
        <geometry>
          <box size="0.08 0.12 0.04"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <geometry>
          <box size="0.08 0.12 0.04"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.2"/>
        <origin xyz="0 0 0"/>
        <inertia
          ixx="3e-4"
          iyy="2e-4"
          izz="2e-4"
          ixy="0"
          ixz="0"
          iyz="0"/>
      </inertial>
    </link>

    <joint name="radar_joint" type="fixed">
      <parent link="base_link"/>
      <child link="radar_front_link"/>
      <origin xyz="0.40 0 0.15"/>
    </joint>

    <!-- Thermal Camera -->
    <link name="camera_thermal_link"/>

    <joint name="camera_thermal_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_thermal_link"/>
      <origin xyz="0.10 0 0.50"/>
    </joint>

  </xacro:macro>

</robot>